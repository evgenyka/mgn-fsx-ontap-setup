# MGN + FSx for ONTAP Setup Configuration
# Update these values for your environment BEFORE running scripts

# AWS Region (where FSx and MGN target instances will be)
REGION="us-west-2"

# Account
ACCOUNT_ID="<your-account-id>"

# VPC and Networking
VPC_ID="<your-vpc-id>"
TARGET_SUBNET_ID="<your-preferred-subnet-id>"
TARGET_SUBNET_CIDR="<preferred-subnet-cidr>"
STANDBY_SUBNET_ID="<your-standby-subnet-id>"
STANDBY_SUBNET_CIDR="<standby-subnet-cidr>"

# FSx for ONTAP configuration
FSX_ADMIN_PASSWORD="<your-fsx-admin-password>"
FSX_STORAGE_CAPACITY=1024        # GB
FSX_THROUGHPUT_CAPACITY=128      # MBps
FSX_ENDPOINT_IP_RANGE="192.168.1.0/24"

# Certificate names
CERT_CA_NAME="my-client-ca"
CERT_USER_NAME="cert_usr"

# -------------------------------------------------------
# OUTPUTS (populated by scripts at runtime - do not edit)
# -------------------------------------------------------
# Source: outputs.env (created by scripts as they run)
